{% doc %}
  Quantity-tier price picker ("Buy 2 for $49.99 / Buy 3 for $69.99 / ...").
  Reads tiers from the gw_tier_discount.tiers product metafield, which is
  written by the GW Bulk Tier Discount admin app. Selecting a tier sets the
  quantity on the theme's own product form, so the theme's native Add to
  cart button adds that quantity.
{% enddoc %}

{% liquid
  assign tiers_json = product.metafields.gw_tier_discount.tiers.value
  if tiers_json == blank
    assign tiers = empty
  else
    assign tiers = tiers_json
  endif
%}

{% if tiers != empty %}
  {% assign variant = product.selected_or_first_available_variant %}
  {% assign unit_price = variant.price | default: 0 %}

  <tier-picker
    class="gw-tier-picker"
    data-block-id="{{ block.id }}"
    data-variant-id="{{ variant.id }}"
    data-unit-price="{{ unit_price }}"
    data-currency="{{ cart.currency.iso_code }}"
    style="
      --gw-accent: {{ block.settings.accent_color }};
      --gw-accent-bg: {{ block.settings.accent_color }}14;
    "
    {{ block.shopify_attributes }}
  >
    <div class="gw-tier-picker__list{% unless block.settings.stack_layout %} gw-tier-picker__list--grid{% endunless %}" role="radiogroup" aria-label="Choose a quantity">
      {% for tier in tiers %}
        {% liquid
          assign qty = tier.quantity
          assign is_percentage = false
          if tier.discountType == "PERCENTAGE"
            assign is_percentage = true
          endif

          if is_percentage
            assign remaining_percent = 100 | minus: tier.price
            assign tier_unit_price_cents = unit_price | times: remaining_percent | divided_by: 100
          else
            assign tier_unit_price_cents = tier.price | times: 100 | round
          endif

          if tier.maxQuantity
            assign range_label = qty | append: '-' | append: tier.maxQuantity
          elsif tier.hasMax
            assign range_label = qty | append: '+'
          else
            assign range_label = qty
          endif

          assign savings_percent = 0
          if unit_price > 0 and unit_price > tier_unit_price_cents
            assign savings_percent = unit_price | minus: tier_unit_price_cents | times: 100 | divided_by: unit_price
          endif
        %}
        <label class="gw-tier-picker__option">
          <input
            type="radio"
            name="gw-tier-{{ block.id }}"
            value="{{ qty }}"
            data-price="{{ tier_unit_price_cents }}"
            {% if tier.maxQuantity %}data-max="{{ tier.maxQuantity }}"{% endif %}
          >
          <span class="gw-tier-picker__check" aria-hidden="true">
            <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3 8.5L6.2 11.5L13 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>

          <span class="gw-tier-picker__main">
            <span class="gw-tier-picker__top-row">
              <span class="gw-tier-picker__range">
                <span class="gw-tier-picker__qty">{{ range_label }}</span>
                <span class="gw-tier-picker__qty-unit">units</span>
              </span>
              {% if savings_percent > 0 %}
                <span class="gw-tier-picker__badge">Save {{ savings_percent }}%</span>
              {% endif %}
            </span>
            {% if tier.label != blank %}
              <span class="gw-tier-picker__tag">{{ tier.label }}</span>
            {% endif %}
          </span>

          <span class="gw-tier-picker__price-col">
            <strong class="gw-tier-picker__price">{{ tier_unit_price_cents | money }}</strong>
            <span class="gw-tier-picker__per-unit">/ unit</span>
            {% if unit_price > tier_unit_price_cents %}
              <s class="gw-tier-picker__compare">{{ unit_price | money }}</s>
            {% endif %}
          </span>
        </label>
      {% endfor %}
    </div>
    <button type="button" class="gw-tier-picker__clear" data-clear-selection hidden>
      Remove bundle
    </button>
  </tier-picker>
  <link rel="stylesheet" href="{{ 'tier-picker.css' | asset_url }}">
  <script src="{{ 'tier-picker.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "Tier price picker",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "stack_layout",
      "label": "Stack tiers vertically",
      "default": true,
      "info": "Turn off to arrange tiers in a 2-column grid instead."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#7b3fa0"
    }
  ]
}
{% endschema %}
